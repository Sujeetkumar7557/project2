
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Wanderlust</title>
  </head>
  <body>
    <h3>Listing Details :</h3>
    <ul>
      <li><%= listing.title %></li>
      <li><%= listing.description %></li>
      <li>&#8377; <%= listing.price.toLocaleString("en-IN") %></li>
      <li><%= listing.location %></li>
      <li><%= listing.country %></li>
    </ul>
    <br />
    <a href="/listings/<%= listing._id %>/edit">Edit this Listing</a>
    <br /><br />
    <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
      <button>Delete this listing</button>
    </form>
    <div class= "col-8 offset-3"> 
      <form action="/listings/<%= listing.id %>/reviews" mrthod="POST">
      <hr>
      <h4>Leave a Reivew</h4>
      <from>
        <div>
          <lebel for= "rating">Rating</lebel>
          <input type="range" min="1" max="5" id="rating" name= "review[rating]">
        </div>
        <div>
          <lebel for= "comment">Comments</lebel>
          <textarea name="review[comment]" id="comment" cols="30" rows="10"></textarea>
        </div>
        <button class="btn-btn-outline-dark">Submit</button>
        <h4>All listings</h4>
        <ul>
          <% for (review of listings.reviews) { %>
            <li><%= review.comment%> , <%=review.reating %> stars</li>
            <% } %>
          </ul>
    </div>
  </body>
</html>