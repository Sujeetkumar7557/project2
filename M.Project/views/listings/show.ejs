<% layout("/layouts/boilerplate") %>
<% const imageUrl = listing.image && listing.image.url ? listing.image.url : "https://theguardianchronicle.com/wp-content/uploads/2026/07/featured-9.jpg"; %>
<div class="row">
  <div class="col-12 col-lg-8 offset-lg-2">
    <h3><%= listing.title %></h3>
    <div class="card show-card">
      <img src="<%= imageUrl %>" class="card-img-top show-img" alt="<%= listing.title %>">
      <div class="card-body">
        <p class="card-text">
          <b><%= listing.title %></b>
        </p>
        <ul class="list-unstyled">
          <li><%= listing.description %></li>
          <li>&#8377; <%= listing.price != null ? listing.price.toLocaleString("en-IN") : "Price unavailable" %></li>
          <li><%= listing.location %></li>
          <li><%= listing.country %></li>
        </ul>
         
        <% if (currUser && listing.owner && currUser._id.equals(listing.owner)) { %>
        <div class="btns">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="ms-2">
            <button class="btn btn-dark">Delete</button>
          </form>
        </div>
        <% } %>
      </div>
    </div>

    <section class="review-section mt-5" aria-labelledby="review-heading">
      <div class="review-panel">
        <h4 id="review-heading">Leave a Review</h4>
        <form method="POST" action="/listings/<%= listing._id %>/reviews">
          <div class="mb-3">
            <label for="rating" class="form-label">Rating</label>
            <input
              type="range"
              class="form-range"
              min="1"
              max="5"
              step="1"
              value="3"
              id="rating"
              name="review[rating]"
              aria-describedby="rating-hint"
            >
            <div id="rating-hint" class="form-text">Choose a rating from 1 to 5.</div>
          </div>
          <div class="mb-3">
            <label for="comment" class="form-label">Comments</label>
            <textarea
              class="form-control"
              name="review[comment]"
              id="comment"
              rows="4"
              required
            ></textarea>
          </div>
          <button type="submit" class="btn btn-dark">Submit Review</button>
        </form>
      </div>

      <div class="reviews-list mt-4">
        <h4>Reviews</h4>
        <% if (listing.reviews.length) { %>
          <% listing.reviews.forEach((review) => { %>
            <article class="review-card">
              <p class="mb-1"><strong>Rating:</strong> <%= review.rating %> / 5</p>
              <p class="mb-0"><%= review.comment %></p>
              <form
                method="POST"
                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                class="mt-2"
              >
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete Review</button>
              </form>
            </article>
          <% }) %>
        <% } else { %>
          <p class="text-muted">No reviews yet. Be the first to review this listing.</p>
        <% } %>
      </div>
    </section>
  </div>
</div>
